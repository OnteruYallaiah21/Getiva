# Copy to backend/.env and fill in values (never commit real secrets).

DATABASE_URL=postgresql://user:password@host:5432/getiva
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (optional fallback storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=getiva_resume

# Backblaze B2 (primary resume storage)
B2_ENABLED=true
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=us-east-005
B2_PUBLIC_BASE_URL=https://f005.backblazeb2.com

GOOGLE_DRIVE_ENABLED=false
